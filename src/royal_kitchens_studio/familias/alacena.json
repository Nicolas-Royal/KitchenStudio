  "componente_base": "componentes/ALACENA.skp",
  "nombre_patron": "ALA-{LenX}-{c25tipopuerta}{d15_cant_puertas}{d21_avento_cant_puertas}[-Z2{d31_z2_contenido}{d35_z2_cant_puertas}{d41_z2_avento_cant_puertas}]{c24entrepano}",
  "nombre_codigos": {
    "c25tipopuerta": { "0": "A", "1": "P", "6": "AS", "10": "AD" },
    "d15_cant_puertas": { "1": "1I", "2": "1D", "3": "2" },
    "c24entrepano": { "0": "-E", "1": "" },
    "d31_z2_contenido": { "0": "A", "1": "P", "6": "AS" },
    "d35_z2_cant_puertas": { "1": "1I", "2": "1D", "3": "2" }
  },
  "catalogo": {
    "categoria": "Alacenas",
    "ubicacion": "Alacena: va colgada en muro, sobre la cubierta.",
    "caracteristicas": {
      "tipo": [
        { "attr": "c25tipopuerta", "valores": { "0": "Abierta", "6": "Avento S", "10": "Avento D" } },
        { "attr": "c24entrepano", "valores": { "0": "Entrepaño" } }
      ],
      "puerta": [{ "attr": "l01_linea_frente" }],
      "configuracion": [
        { "attr": "d01_cantidad_zonas" },
        { "attr": "d15_cant_puertas" },
        { "attr": "d21_avento_cant_puertas", "prefijo": "Avento: " },
        { "attr": "d31_z2_contenido", "prefijo": "Zona 2: " }
      ]
    }
  },
  "reglas_frentes": { "nombre": "{pieza} {linea}", "attr_linea": "l01_linea_frente", "piezas": { "Puerta": "PUERTA" } },
  "poda": [
    {
      "_doc": "Las mismas variantes que en el gabinete: la puerta, la hoja de cada Avento y sus manijas salen de la puerta del gabinete (componentes/ALACENA.skp, 20/10/2026). El frente de cada hoja se llama «Puerta». B.Tirador son tiradores viejos fuera del catálogo.",
      "padres": ["Puerta"],
      "attrs": ["l01_linea_frente"],
      "variantes": {
        "CE_Panel": ["1", "2"],
        "Panel": ["3"],
        "TAP.Mitered": ["3"],
        "MFP *": ["4"],
        "RFP *": ["5"],
        "RRP *": ["6"],
        "CE *": ["7"],
        "CEFP *": ["8"],
        "LEI *": ["9"],
        "ING *": ["10"]
      }
    },
    {
      "padres": ["PuertaIZQ", "PuertaDER", "Puerta", "PuertaSUP", "PuertaINF"],
      "attrs": ["d16_tirador_tipo"],
      "variantes": {
        "B.TiradorCLE": ["7"],
        "Tirador New Chica": ["8"],
        "Tirador Andrea": ["9"],
        "Tirador Escolano": ["10"],
        "Tirador Barra negra": ["11"],
        "Tirador Boton cilindrico chico": ["12"],
        "Tirador Paola": ["13"],
        "Tirador Mulholland": ["14"],
        "Tirador Concha dorada": ["15"],
        "Tirador Boton Oberol": ["16"],
        "Tirador Swarovski chica": ["17"],
        "Tirador Swarovski grande": ["18"],
        "Tirador Boton cilindrico dorado": ["19"],
        "Tirador Boton cilindrico plateado": ["20"],
        "B.PerfilTirador Berlin": ["21"],
        "B.Tirador": []
      }
    }
  ],
  "nombres_piezas": [
    {
      "_doc": "Como en el gabinete (Engine.nombrar_piezas). Puertas: PUERTA IZQ/DER (abatible), PUERTA AVENTO (S, en cualquier zona) y PUERTA AVENTO SUP/INF (D), sobre el nombre que les puso reglas_frentes."
    },
    { "ruta": ["PUERTA *"], "dentro": "PuertaIZQ", "nombre": "PUERTA IZQ" },
    { "ruta": ["PUERTA *"], "dentro": "PuertaDER", "nombre": "PUERTA DER" },
    { "ruta": ["PUERTA *"], "dentro": "PuertaSUP", "nombre": "PUERTA AVENTO SUP" },
    { "ruta": ["PUERTA *"], "dentro": "PuertaINF", "nombre": "PUERTA AVENTO INF" },
    { "ruta": ["PUERTA *"], "dentro": "PUERTA AVENTO S*", "nombre": "PUERTA AVENTO" },
    { "ruta": ["LateralL", "Panel"], "nombre": "LATERAL IZQUIERDA" },
    { "ruta": ["LateralR", "Panel"], "nombre": "LATERAL DERECHA" },
    { "ruta": ["Estructura", "Base", "Panel"], "nombre": "PISO" },
    { "ruta": ["Estructura", "Techo", "Panel"], "nombre": "TECHO" },
    { "ruta": ["Estructura", "Fondo", "Panel"], "nombre": "RESPALDO" },
    { "ruta": ["B.AmarrePost", "Amarre", "Panel"], "nombre": "AMARRE POSTERIOR" },
    { "ruta": ["Repisa", "Panel"], "nombre": "ENTREPAÑO", "segun": { "attr": "margenfrontal", "valores": { "0": "DIVISOR" }} },
    { "ruta": ["BisCazoletaL"], "nombre": "BISAGRA CAZOLETA", "unidad": true },
    { "ruta": ["BisCazoletaR"], "nombre": "BISAGRA CAZOLETA", "unidad": true },
    { "ruta": ["B.TiradorCLE"], "nombre": "MANIJA LATERAL NEGRA", "unidad": true },
    { "ruta": ["B.PerfilTirador Berlin"], "nombre": "MANIJA BERLÍN", "unidad": true },
    { "ruta": ["Tirador New Chica"], "nombre": "MANIJA NEW CHICA", "unidad": true },
    { "ruta": ["Tirador Andrea"], "nombre": "MANIJA ANDREA", "unidad": true },
    { "ruta": ["Tirador Escolano"], "nombre": "MANIJA ESCOLANO", "unidad": true },
    { "ruta": ["Tirador Barra negra"], "nombre": "MANIJA BARRA NEGRA", "unidad": true },
    { "ruta": ["Tirador Boton cilindrico chico"], "nombre": "MANIJA BOTÓN CILÍNDRICO CHICO", "unidad": true },
    { "ruta": ["Tirador Paola"], "nombre": "MANIJA PAOLA", "unidad": true },
    { "ruta": ["Tirador Mulholland"], "nombre": "MANIJA MULHOLLAND", "unidad": true },
    { "ruta": ["Tirador Concha dorada"], "nombre": "MANIJA CONCHA DORADA", "unidad": true },
    { "ruta": ["Tirador Boton Oberol"], "nombre": "MANIJA BOTÓN OBEROL", "unidad": true },
    { "ruta": ["Tirador Swarovski chica"], "nombre": "MANIJA SWAROVSKI CHICA", "unidad": true },
    { "ruta": ["Tirador Swarovski grande"], "nombre": "MANIJA SWAROVSKI GRANDE", "unidad": true },
    { "ruta": ["Tirador Boton cilindrico dorado"], "nombre": "MANIJA BOTÓN CILÍNDRICO DORADO", "unidad": true },
    { "ruta": ["Tirador Boton cilindrico plateado"], "nombre": "MANIJA BOTÓN CILÍNDRICO PLATEADO", "unidad": true }
  ],
  "reglas_divisores": {
    "prefijo": "divisor",
    "attr_cantidad": "divisor>f01cantdiv",
    "attr_modo": "divisor>g01margenf{i}",
    "nombres_por_modo": { "0mm": "Divisor" },
    "nombre_default": "Entrepaño",
    "presupuesto": {
      "attr_alto_util": "LenZ",
      "solo_si": { "attr": "divisor>f02tipomedida", "valor": "2" },
      "attrs_espacio": ["divisor>f03espacio1", "divisor>f03espacio2", "divisor>f03espacio3", "divisor>f03espacio4", "divisor>f03espacio5", "divisor>f03espacio6"]
    }
  },
  "reglas_geometria": [
    { "attrs": ["d02_alto_zona_superior"], "menor_que": "LenZ", "mensaje": "La zona de arriba no deja lugar a la de abajo: mide más que el alto." },
    {
      "attrs": ["f11margsupcaj", "f12marginfcaj"],
      "menor_que": "LenZ",
      "mensaje": "Los márgenes superior e inferior no dejan frente: suman más que el alto."
    },
    {
      "attrs": ["f13margizqcaj", "f14margdercaj"],
      "menor_que": "LenX",
      "mensaje": "Los márgenes izquierdo y derecho no dejan frente: suman más que el ancho."
    },
    { "attrs": ["c01espestr"], "menor_que": "LenX", "mensaje": "El espesor de estructura no puede alcanzar el ancho." },
    { "attrs": ["c01espestr"], "menor_que": "LenY", "mensaje": "El espesor de estructura no puede alcanzar la profundidad." },
    { "attrs": ["c01espestr"], "menor_que": "LenZ", "mensaje": "El espesor de estructura no puede alcanzar el alto." },
    { "attrs": ["c02esppuerta"], "menor_que": "LenY", "mensaje": "El espesor de puerta no puede alcanzar la profundidad." },
    { "attrs": ["c03espfondo"], "menor_que": "LenY", "mensaje": "El espesor de fondo no puede alcanzar la profundidad." }
  ],
  "valores_componente": {
    "_doc": "Variables del componente que Studio fija en cada generación (no van en el formulario). La alacena lleva una sola manija de puertas (d16, d19): la zona 2 la toma de ahí; su posición (d37/d38) sí es propia, según el tipo de puerta de la zona.",
    "d36_z2_tirador_tipo": "=d16_tirador_tipo",
    "d39_z2_tirador_largo": "=d19_tirador_largo"
  },
  "grupos": [
