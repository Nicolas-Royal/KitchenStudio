      "id": "dimensiones",
      "titulo": "Dimensiones",
      "campos": [
        {
          "id": "LenX",
          "attr": "LenX",
          "label": "Ancho",
          "tipo": "numero",
          "unidad": "mm",
          "default": "",
          "placeholder": "800",
          "positivo": true,
          "requerido": true
        },
        {
          "id": "LenY",
          "attr": "LenY",
          "label": "Profundidad del cuerpo",
          "tipo": "numero",
          "unidad": "mm",
          "default": "",
          "placeholder": "330",
          "positivo": true,
          "requerido": true,
          "nota": "Sin la puerta: el componente mide la profundidad total, así que se le suma el espesor de puerta.",
          "suma": [{ "attr": "c02esppuerta" }]
        },
        {
          "id": "LenZ",
          "attr": "LenZ",
          "label": "Alto",
          "tipo": "numero",
          "unidad": "mm",
          "default": "",
          "placeholder": "700",
          "positivo": true,
          "requerido": true
