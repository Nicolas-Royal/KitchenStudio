  "piezas_unicas": [
    {
      "_doc": "La lateral con gola (la del gabinete) sale en dos piezas: cuerpo y tira al frente debajo de la muesca. En OpenCutList, UNA pieza con la medida total.",
      "grupo": "CEGolaLat"
    },
    {
      "_doc": "Piso y entrepaños en L: dos mitades (PanelCE01/02) que en SketchUp siguen separadas y dinámicas (se editan y conservan sus fórmulas); en OpenCutList, UNA pieza por L. Antes los entrepaños se fusionaban (reglas_union) y perdían el componente dinámico. Los contenedores se llaman así en ESQUINERO.skp.",
      "grupo": "PISO EN L"
    },
    { "grupo": "ENTREPAÑO EN L" }
