  "tipos_material": {
    "_doc": "Lo que depende de la familia del material (materiales[].familia). espesor_puerta = mm de puertas y tapas (familias.<f>.espesor_puerta): la madera, incluida su Lisa, es de 22; el MDF solo existe en Lisa y es de 18. canto_frente = si las puertas y tapas lisas llevan cubrecanto (CANTO EXTERIOR) en planeación: el MDF sí; la madera no (Acabado.frentes_segun_material las pasa a SinCanto). grosores = espesores estándar del tablero en OpenCutList (estructura 18, puertas de madera 22). Todos los materiales del catálogo son «Tablero» en OpenCutList (Catalogo.marcar_tablero): si no, no deja ponerles canto. Sin entrada (Sin material): el espesor del mueble y su canto.",
    "MDF": { "espesor_puerta": 18, "canto_frente": true, "grosores": "18mm" },
    "Madera": { "espesor_puerta": 22, "canto_frente": false, "grosores": "18mm;22mm" }
  },
  "textura_veta": {
    "_doc": "Textura base de la madera sin foto: la de TEKA ARTICO-VESTO1 del gabinete base (veta recta). Studio la tiñe con el color de cada material con veta: pixel = color × luminancia / luminancia media (Acabado.tenir y el filtro de RKVista). ancho/alto = lo que cubre en SketchUp.",
    "foto": "texturas/veta_teka_artico.png",
    "ancho_mm": 1800,
    "alto_mm": 400,
    "luminancia": 215.2
  },
  "colores_gola_aluminio": {
    "Aluminio anodizado mate": "#c4c8cc",
    "Negro mate": "#2a2c2e",
    "Champagne mate": "#cdb991",
    "Gris mate": "#8d9396"
  },
  "familias": {
    "alacena": {
      "_doc": "Componente ALACENA.skp (20/10/2026): la puerta y los Avento llevan la puerta del gabinete. Sin gola ni tarja ni cajones; la posición de la manija la fija el manifiesto (abajo).",
      "medidas": {
        "ancho": "LenX",
        "alto": "LenZ",
        "fondo": "LenY"
      },
      "frente": {
        "attr": "l01_linea_frente"
      },
      "sin_frente": {
        "_doc": "«Sin frente» en el tipo de frente del mueble (no en el diseño del proyecto): abierto, sin puertas ni cajones ni manijas ni gola. Catalogo.cambios_receta y RKReglas.sinFrente.",
        "valores": {
