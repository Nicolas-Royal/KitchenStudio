          "c17matfondope": "{material}",
          "c21matestrde": "{material}",
          "c23matfondode": "{material}"
        }
      }
    },
    "esquinero": {
      "_doc": "Componente ESQUINERO.skp (23/10/2026): la puerta en L son dos hojas de la puerta del gabinete. Gola solo L arriba (aluminio o melamina del gabinete, sin combinación). Sin tarja ni cajones; la posición de la manija la fija el manifiesto. «fondo» es el ancho derecho (LenY): las profundidades de cada ala son del mueble.",
      "medidas": {
        "ancho": "LenX",
        "alto": "LenZ",
        "fondo": "LenY"
      },
      "medidas_ui": {
        "ancho": { "label": "Ancho izquierdo", "presets": [800, 900, 1000, 1100, 1200] },
