      },
      "frente": {
        "attr": "l01_linea_frente"
      },
      "sin_frente": {
        "_doc": "«Sin frente» en el tipo de frente del mueble (no en el diseño del proyecto): abierto, sin puertas ni cajones ni manijas ni gola. Catalogo.cambios_receta y RKReglas.sinFrente.",
        "valores": {
          "c25tipopuerta": "0",
          "b01_gola_o_tirador": "1"
        }
      },
